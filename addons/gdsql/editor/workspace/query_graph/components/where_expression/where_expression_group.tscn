text = "↑"

[node name="MoveDown" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
tooltip_text = "Move group down"
text = "↓"

[node name="Remove" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
