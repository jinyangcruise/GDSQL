[ext_resource type="Texture2D" path="res://addons/gdsql/editor/workspace/icons/trash_can.svg" id="4_trash"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_group"]
bg_color = Color(0.12, 0.13, 0.15, 0.45)
border_width_left = 2
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.32, 0.38, 0.48, 0.8)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="WhereExpressionGroup" type="PanelContainer"]
custom_minimum_size = Vector2(0, 42)
theme_override_styles/panel = SubResource("StyleBoxFlat_group")
script = ExtResource("1_group")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FirstMarker" type="Label" parent="Margin/Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
text = "IF"
vertical_alignment = 1

[node name="Connector" type="OptionButton" parent="Margin/Layout/Header"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(60, 0)
layout_mode = 2

[node name="Collapse" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
tooltip_text = "Collapse group"
text = "▼"
flat = true

[node name="GroupLabel" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.84, 1)
text = "GROUP"
vertical_alignment = 1

[node name="Invert" type="CheckButton" parent="Margin/Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
tooltip_text = "Invert this entire group"
text = "NOT"

[node name="Summary" type="Label" parent="Margin/Layout/Header"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.62, 0.67, 0.74, 1)
text = "(<group summary>)"
text_overrun_behavior = 3

[node name="HeaderSpacer" type="Control" parent="Margin/Layout/Header"]
layout_mode = 2
