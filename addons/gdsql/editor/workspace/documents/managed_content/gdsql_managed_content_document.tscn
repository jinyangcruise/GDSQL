[node name="Content" type="VBoxContainer" parent="Scroll"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Eyebrow" type="Label" parent="Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.68, 1, 1)
text = "RUNTIME CONTENT"

[node name="Title" type="Label" parent="Scroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Managed content setup"

[node name="Description" type="Label" parent="Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.72, 0.78, 1)
text = "Build one effective content database from an immutable base package and optional DLC or mod packages."
autowrap_mode = 2

[node name="ConfigurationPanel" type="PanelContainer" parent="Scroll/Content"]
layout_mode = 2

