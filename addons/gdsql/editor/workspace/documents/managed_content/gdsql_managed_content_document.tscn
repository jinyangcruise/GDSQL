[gd_scene format=3]

[ext_resource type="Script" path="res://addons/gdsql/editor/workspace/documents/managed_content/gdsql_managed_content_document.gd" id="1"]

[node name="ManagedContentDocument" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
