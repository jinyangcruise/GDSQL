[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://addons/gdsql/editor/workspace/documents/gdsql_welcome_document.gd" id="1"]
[ext_resource type="Script" path="res://addons/gdsql/editor/controller/components/gdsql_editor_action_button.gd" id="2"]

[node name="WelcomeDocument" type="CenterContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="WelcomePanel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(580, 0)
layout_mode = 2

[node name="WelcomeMargin" type="MarginContainer" parent="WelcomePanel"]
layout_mode = 2
theme_override_constants/margin_left = 42
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 42
theme_override_constants/margin_bottom = 36

[node name="Content" type="VBoxContainer" parent="WelcomePanel/WelcomeMargin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Eyebrow" type="Label" parent="WelcomePanel/WelcomeMargin/Content"]
layout_mode = 2
text = "GDSQL WORKBENCH"
horizontal_alignment = 1

[node name="Title" type="Label" parent="WelcomePanel/WelcomeMargin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Build and inspect game databases"
horizontal_alignment = 1

[node name="Description" type="Label" parent="WelcomePanel/WelcomeMargin/Content"]
layout_mode = 2
text = "Known databases are discovered automatically. Open one from the dock or create a new database workspace."
horizontal_alignment = 1
autowrap_mode = 2

[node name="CreateDatabase" type="Button" parent="WelcomePanel/WelcomeMargin/Content"]
layout_mode = 2
size_flags_horizontal = 4
text = "Create Database"
script = ExtResource("2")
