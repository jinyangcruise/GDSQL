[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/gdsql/editor/activity/gdsql_activity_panel.gd" id="1_activity"]

[node name="ActivityPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(500, 180)
theme_override_constants/separation = 0
script = ExtResource("1_activity")

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Toolbar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Database operations and diagnostics"

[node name="Clear" type="Button" parent="Toolbar"]
layout_mode = 2
text = "Clear"
flat = true

[node name="Activity" type="Tree" parent="."]
layout_mode = 2
size_flags_vertical = 3
columns = 4
column_titles_visible = true
hide_root = true
